EV_PROFILE=public
EV_CORPUS_VERSION=v1
EV_PROMPT_VERSION=p1
EV_DATABASE_URL=postgresql://ergovault:ergovault@localhost:5433/ergovault
# Порт, который docker-compose.yml публикует наружу для сервиса db (не EV_-переменная,
# читается самим docker compose, а не Settings) — должен совпадать с портом в EV_DATABASE_URL.
POSTGRES_PORT=5433
EV_EMBED_MODEL=BAAI/bge-m3
EV_GEN_MODEL=claude-opus-5
EV_JUDGE_MODEL=claude-sonnet-5
EV_RETRIEVAL_MODE=hybrid
EV_TOP_K=8

# Доступ к модели. cli = по подписке через Claude Code, ключ не нужен (режим по умолчанию).
# api = прямой Anthropic SDK, нужен ключ; используется только для чистых замеров в T-30.
EV_LLM_BACKEND=cli
EV_ANTHROPIC_API_KEY=
