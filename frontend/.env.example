# Базовый URL API. Пусто — запросы идут на текущий origin.
# Пока API нет (T-22), работают моки msw; переключение на живой бэкенд — эта переменная.
VITE_API_BASE_URL=

# on  — перехватывать запросы моками msw (значение по умолчанию в dev)
# off — ходить в живой API по VITE_API_BASE_URL
VITE_USE_MOCKS=on
