# Базовый URL API. Пусто — запросы идут на текущий origin, а dev-сервер проксирует
# /api и /healthz на бэкенд (см. vite.config.ts). Заполнять нужно, только если API
# поднят на другом адресе — тогда он должен разрешить этот origin в EV_CORS_ORIGINS.
VITE_API_BASE_URL=

# off — обычный запуск: живой API (`uvicorn ergovault.api:app --port 8000`)
# on  — демонстрационные сценарии msw без бэкенда; включается режимом `npm run dev:mock`
VITE_USE_MOCKS=off
